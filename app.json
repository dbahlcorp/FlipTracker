{
  "expo": {
    "name": "Kerf",
    "slug": "kerf",
    "version": "1.0.1",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#22c55e",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bahlcorp.fliptracker",
      "buildNumber": "27",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos to your jobs.",
        "CFBundleDisplayName": "Kerf",
        "CFBundleShortVersionString": "1.0.1",
        "LSApplicationQueriesSchemes": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111F"
      },
      "package": "com.dbahlcorp.kerf"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "95332259-9c93-41ac-829b-7ff58432cb57"
      }
    },
    "owner": "dbahlcorp",
    "plugins": [
      "expo-font",
      "expo-sqlite"
    ]
  }
}
